# Docker image/build metadata
GURU_DOCKER_IMAGE=guru-node:local
GURU_VERSION=dev
GURU_COMMIT=unknown

# Network identity and local transaction policy
GURU_CHAIN_ID=guru_631-1
GURU_EVM_CHAIN_ID=631
GURU_MINIMUM_GAS_PRICES=630000000000agxn

# CometBFT connectivity
GURU_P2P_BIND_IP=0.0.0.0
GURU_P2P_PORT=26656
GURU_P2P_SEEDS=
GURU_PERSISTENT_PEERS=

# Used only with compose.local.yaml
GURU_RPC_BIND_IP=127.0.0.1
GURU_RPC_PORT=26657
GURU_API_ENABLE=false
GURU_API_BIND_IP=127.0.0.1
GURU_API_PORT=1317
GURU_GRPC_BIND_IP=127.0.0.1
GURU_GRPC_PORT=9090
GURU_JSON_RPC_ENABLE=false
GURU_JSON_RPC_BIND_IP=127.0.0.1
GURU_JSON_RPC_PORT=8545
GURU_JSON_RPC_WS_PORT=8546
